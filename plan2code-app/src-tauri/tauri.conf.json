{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plan2Code",
  "version": "3.0.0",
  "identifier": "com.plan2code.app",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/vendor.mjs",
    "beforeBuildCommand": "node scripts/vendor.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Plan2Code",
        "width": 1280,
        "height": 800,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
