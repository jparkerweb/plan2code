diff --git a/src/tasks/routes.js b/src/tasks/routes.js
new file mode 100644
index 0000000..b7d5e22
--- /dev/null
+++ b/src/tasks/routes.js
@@ -0,0 +1,14 @@
+import { paginate } from "./paginate.js";
+import { taskSchema } from "./schema.js";
+
+// The /tasks routes: list with paging and filters, create, update, delete.
+export default async function routes(app) {
+  app.get("/tasks", async (req) => {
+    const { cursor, limit, status, assignee } = req.query;
+    const all = await app.db.tasks.find({ status, assignee });
+    return paginate(all, cursor, Number(limit) || undefined);
+  });
+
+  app.post("/tasks", { schema: { body: taskSchema } }, async (req, reply) => {
+    return reply.code(201).send(await app.db.tasks.insert(req.body));
+  });
+}
